# Single source of version pins. Read by docker/compose.yaml (via --env-file),
# scripts/*.sh and the CI workflow. Change versions here only.

# CARLA server and the Python client built from the same source tag. The client
# and server must come from the same release or the RPC handshake fails.
CARLA_VERSION=0.10.0
CARLA_GIT_URL=https://github.com/carla-simulator/carla.git
CARLA_GIT_REF=0.10.0
CARLA_IMAGE=carlasim/carla:0.10.0

# Autoware runtime. The client wheel must match this image's Python
# (humble -> cp310 on Ubuntu 22.04, jazzy -> cp312 on Ubuntu 24.04). CARLA_IMAGE
# ships a cp310 wheel; for any other tag it is built from source on
# CLIENT_BUILD_BASE.
ROS_DISTRO=humble
AUTOWARE_IMAGE=ghcr.io/autowarefoundation/autoware:universe-cuda-humble
CLIENT_PYTHON_TAG=cp310
CLIENT_BUILD_BASE=ubuntu:22.04

# autoware_carla_interface is rebuilt from this autoware_universe commit: its
# CARLA 0.10 workarounds (wake_sleeping_physics, min_positive_throttle, ground
# snapping, ...) are on main but not in any release the image ships.
AUTOWARE_UNIVERSE_URL=https://github.com/autowarefoundation/autoware_universe.git
AUTOWARE_UNIVERSE_REF=5c750db97464a7f29c28d0d7857f7c44e9f70e97
BRIDGE_IMAGE=carla-autoware-ros2/bridge:humble

# Autoware maps recorded from CARLA 0.10 itself (the 0.9 town maps do not match
# the UE5 geometry). The dataset has no tag yet, so it is pinned to a commit.
MAPS_HF_DATASET=AutowareFoundation/carla-ue5-maps
MAPS_HF_REVISION=682ddd48b4cf305507646cb2f2e563bbedac4c2e
CARLA_WORLD=Town10HD_Opt

# Ego vehicle. vehicle.toyota.prius (the bridge default) does not exist in 0.10.
EGO_VEHICLE=vehicle.lincoln.mkz
